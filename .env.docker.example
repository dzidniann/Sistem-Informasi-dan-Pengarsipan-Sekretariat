# Salin isi ini ke file .env kamu, sesuaikan bagian yang perlu

APP_NAME="Sistem Kesekretariatan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Perhatikan: DB_HOST diisi nama service di docker-compose.yml (bukan 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sim_kesekretariatan
DB_USERNAME=sim_user
DB_PASSWORD=sim_password

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
