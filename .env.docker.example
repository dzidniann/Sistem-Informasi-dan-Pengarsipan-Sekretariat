# Salin ke .env.docker untuk Docker. Pertahankan APP_KEY jika menyalin data.

APP_NAME="Sistem Kesekretariatan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Perhatikan: DB_HOST diisi nama service di docker-compose.yml (bukan 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sim_kesekretariatan
DB_USERNAME=sim_user
DB_PASSWORD=GANTI_PASSWORD_DATABASE
MYSQL_DATABASE=sim_kesekretariatan
MYSQL_USER=sim_user
MYSQL_PASSWORD=GANTI_PASSWORD_DATABASE
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT

SESSION_DRIVER=file
SESSION_COOKIE=sso_pdam_docker_session
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
