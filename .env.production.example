COMPOSE_PROJECT_NAME=simarta-office
RELEASE_TAG=REPLACE_WITH_COMMIT_SHA
WEB_BIND_IP=127.0.0.1
# Selected by the project owner; recheck availability and office IT policy before start.
WEB_PORT=8500
APP_NAME=SIMARTA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://simarta.tirtahita.my.id
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simarta
DB_USERNAME=simarta
DB_PASSWORD=
MYSQL_ROOT_SECRET_FILE=./.secrets/mysql-root-password
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=simarta_office_session
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=protected
BROADCAST_DRIVER=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=simarta@example.invalid
MAIL_FROM_NAME=SIMARTA
# Resolve only this Compose service on the project's private network per request.
# No fixed IP/subnet, wildcard or entire network is trusted.
TRUSTED_PROXY_HOSTS=webserver
TRUSTED_PROXIES=
# Host-side backup script setting; not an automatic mount or scheduled backup.
# Must be set to an IT-approved absolute writable path before backing up.
SIMARTA_BACKUP_ROOT=
# For release: set approved tag@sha256 digests, not floating tags.
PHP_IMAGE=php:8.2.35-fpm-bookworm
NODE_IMAGE=node:22.14.0-bookworm-slim
COMPOSER_IMAGE=composer:2.8.6
NGINX_IMAGE=nginx:1.28.0-alpine
MYSQL_IMAGE=mysql:8.0.42
